# Copy this to .env.local. Never commit API keys.
# Use keys from separate Google Cloud projects if you need independent quota pools.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Optional comma- or newline-separated additional keys; keep this secret.
GEMINI_API_KEYS=
# Preferred model; GENE can fall back to gemini-3.6-flash and gemini-3.5-flash-lite.
GENE_FAST_MODEL=gemini-3.8-flash

# Optional cross-provider recovery (server-side only; free-tier limits vary).
GROQ_API_KEY=
GENE_GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter: GENE discovers currently-free models from OpenRouter's public catalog automatically
# (only models priced 0/0 are used) and rotates past unavailable ones. No model setting is needed.
OPENROUTER_API_KEY=
# Optional: pin a model. It is used ONLY if the live catalog confirms it is free.
GENE_OPENROUTER_MODEL=
# A second provider reviews generated code before saving when a backup key exists. Set false to disable.
GENE_AI_REVIEW=true

# Optional protected static publishing through Vercel. Keep all values secret.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=gene-flash
VERCEL_TEAM_ID=
GENE_PUBLISH_PASSWORD=

# Cloud EXE/APK builds (same encryption key must be set in Vercel and GitHub Actions secrets)
GENE_BUILD_GITHUB_TOKEN=
GENE_BUILD_PASSWORD=
GENE_BUILD_ENCRYPTION_KEY=
GENE_BUILD_REPOSITORY=Mody2024/GENE
