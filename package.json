{
  "name": "gene",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@gene/web",
    "build": "npm run build --workspace=@gene/web",
    "start": "npm run start --workspace=@gene/web",
    "typecheck": "npx tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node tests/smoke.mjs && node tests/gene2.mjs && node tests/cancellation-contract.mjs && node tests/workspace-file-ops-contract.mjs && node tests/native-brain.mjs && node tests/native-generator.mjs && node tests/forge-presets.mjs && node tests/forge-route-contract.mjs && node tests/forge-chat-integration.mjs",
    "test:native-brain": "node tests/native-brain.mjs && node tests/native-generator.mjs",
    "agent:dev": "npm run start --workspace=@gene/local-agent",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:playground": "node tests/playground.mjs",
    "test:live-generation": "node tests/live-generation-smoke.mjs",
    "test:studio-ui": "node tests/studio-responsive.mjs",
    "test:quality": "node tests/game-quality-benchmark.mjs",
    "test:native-browser": "node tests/native-browser.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
