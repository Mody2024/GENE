{
  "name": "gene",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@gene/web",
    "build": "npm run build --workspace=@gene/web",
    "start": "npm run start --workspace=@gene/web",
    "typecheck": "npx tsc --noEmit -p apps/web/tsconfig.json",
    "test": "node tests/smoke.mjs && node tests/gene2.mjs && node tests/cancellation-contract.mjs && node tests/workspace-file-ops-contract.mjs",
    "agent:dev": "npm run start --workspace=@gene/local-agent",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
